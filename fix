//+------------------------------------------------------------------+
//| Signal Type Enum                                                 |
//+------------------------------------------------------------------+
enum ENUM_SIGNAL_TYPE
{
   SIGNAL_NONE = 0,
   SIGNAL_BUY = 1,
   SIGNAL_SELL = 2,
   SIGNAL_HOLD = 3
};

//+------------------------------------------------------------------+
//| AI Analysis Result Structure                                     |
//+------------------------------------------------------------------+
struct AIAnalysisResult
{
   double       risk_score;
   double       confidence;
   ENUM_SIGNAL_TYPE signal;
   string       reasoning;
   double       suggested_sl;
   double       suggested_tp;
   double       position_size;
   datetime     analysis_time;
};
