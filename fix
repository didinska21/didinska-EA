//+------------------------------------------------------------------+
//| TestBackend.mq5                                                  |
//| MT5 -> FastAPI connection test                                   |
//+------------------------------------------------------------------+
#property strict
#property script_show_inputs

input string BackendURL = "http://127.0.0.1:8000";

void OnStart()
{
   Print("========================================");
   Print(" MT5 -> FASTAPI CONNECTION TEST");
   Print("========================================");

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
   {
      Print("ERROR: Cannot read current tick for ", _Symbol);
      return;
   }

   double daily_high = iHigh(_Symbol, PERIOD_D1, 0);
   double daily_low  = iLow(_Symbol, PERIOD_D1, 0);
   double daily_open = iOpen(_Symbol, PERIOD_D1, 0);
   long volume       = iVolume(_Symbol, PERIOD_H1, 0);
   long spread       = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);

   string json = "{";
   json += "\"symbol\":\"" + _Symbol + "\",";
   json += "\"bid\":" + DoubleToString(tick.bid, 5) + ",";
   json += "\"ask\":" + DoubleToString(tick.ask, 5) + ",";
   json += "\"spread\":" + IntegerToString((int)spread) + ",";
   json += "\"volume\":" + IntegerToString((int)volume) + ",";
   json += "\"daily_high\":" + DoubleToString(daily_high, 5) + ",";
   json += "\"daily_low\":" + DoubleToString(daily_low, 5) + ",";
   json += "\"daily_open\":" + DoubleToString(daily_open, 5);
   json += "}";

   string url = BackendURL + "/api/v1/trading/signal";
   string headers = "Content-Type: application/json\r\n";

   char post_data[];
   char result[];
   string result_headers;

   StringToCharArray(json, post_data, 0, StringLen(json));

   Print("URL: ", url);
   Print("Request: ", json);

   ResetLastError();

   int http_code = WebRequest(
      "POST",
      url,
      headers,
      5000,
      post_data,
      result,
      result_headers
   );

   int error_code = GetLastError();

   Print("HTTP Code: ", http_code);
   Print("MT5 Error: ", error_code);

   if(http_code >= 200 && http_code < 300)
   {
      string response = CharArrayToString(result);

      Print("SUCCESS: FastAPI responded!");
      Print("Response: ", response);
   }
   else
   {
      Print("FAILED: FastAPI request failed.");
      Print("Response: ", CharArrayToString(result));
   }

   Print("========================================");
   Print(" TEST COMPLETE");
   Print("========================================");
}
